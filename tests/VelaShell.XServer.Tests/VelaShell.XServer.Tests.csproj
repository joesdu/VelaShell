<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VelaShell.XServer 的测试。文件夹与被测项目一一对应;TestKit/ 里是内存传输与
    一个逐字节构造请求的最小协议客户端。

    **默认不连网、不起容器。** 连真实 X 客户端(Docker 里的 xdpyinfo / xterm / xeyes)的用例
    标 [TestCategory("Interop")],环境变量 VELASHELL_XSERVER_INTEROP=1 时才真跑,否则早退并在
    TestContext 里写一行 [SKIP](MSTest 会把早退记为通过 —— 看 [SKIP] 行才知道跑没跑)。
  -->

  <PropertyGroup>
    <!-- MIT-SHM 用例经 LibraryImport 调 libc 的 shmget / shmat 建共享内存段。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- 中文用例名里的下划线是协议标识符本身(与 VelaShell.Ssh.Tests 同一理由)。 -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VelaShell.XServer\VelaShell.XServer.csproj" />
  </ItemGroup>

</Project>
