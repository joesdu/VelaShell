<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="VelaShell.PluginSdk.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真 ssh-keygen 生成的加密私钥(64 轮 bcrypt_pbkdf),口令见那边的 README。 -->
    <None Include="..\VelaShell.Ssh.Tests\Keys\Fixtures\ed25519-rounds64" Link="Ssh\Fixtures\ed25519-rounds64" CopyToOutputDirectory="PreserveNewest" />
    <!-- puttygen 生成的加密 .ppk(v3,Argon2id)与它导出的 .pub:导入「只有 .ppk」时用。 -->
    <None Include="..\VelaShell.Ssh.Tests\Keys\Fixtures\putty-ed25519-v3-hi-enc.ppk" Link="Ssh\Fixtures\putty-ed25519-v3-hi-enc.ppk" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\VelaShell.Ssh.Tests\Keys\Fixtures\putty-ed25519-v3-hi-enc.pub" Link="Ssh\Fixtures\putty-ed25519-v3-hi-enc.pub" CopyToOutputDirectory="PreserveNewest" />
    <!-- 真 ssh-keygen 签发的主机证书与 CA 公钥(hostcert-*,只取 .pub):受信主机 CA 的裁决用例用。 -->
    <None Include="..\VelaShell.Ssh.Tests\Keys\Fixtures\hostcert-*.pub" Link="Ssh\Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VelaShell.Infrastructure\VelaShell.Infrastructure.csproj" />
    <!-- 插件运行时端到端测试需要真实的插件程序集(装载走的是"从磁盘目录发现 plugin.json →
         在可收集 ALC 里装载独立 dll"这条真路径,测试程序集里手写个假入口顶不上)。
         夹具见 tests/fixtures/README.md —— 拆库前这个角色由 plugins/ 下的 HelloWorld
         与 Telnet 兼任,插件搬走后显式化成两个夹具工程。 -->
    <ProjectReference Include="..\fixtures\VelaShell.TestPlugin\VelaShell.TestPlugin.csproj" />
    <!-- 终端协议 e2e:把夹具(含它自己的 plugin.json)铺进临时插件根,
         验证"清单发现 → 惰性激活 → 注册成终端协议 → 宿主适配 → 真实套接字"整条链。 -->
    <ProjectReference Include="..\fixtures\VelaShell.TestPlugin.Terminal\VelaShell.TestPlugin.Terminal.csproj" />
    <!-- 隔离模式 e2e:测试目录里要有真实的 PluginHost 可执行。 -->
    <ProjectReference Include="..\..\src\VelaShell.PluginHost\VelaShell.PluginHost.csproj" />
  </ItemGroup>

</Project>
