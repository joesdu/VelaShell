<?xml version="1.0" encoding="utf-8"?>
<!--
  全仓测试运行设置。经 tests/Directory.Build.targets 的 RunSettingsFilePath 自动应用,
  无需在命令行显式指定。

  TestTimeout 是这里的重点。VelaShell.Tests 的所有 UI 测试共用**同一条** headless UI 线程
  (每个类都走 HeadlessUnitTestSession.GetOrStartForAssembly),Dispatch 的工作项在这条线程上
  顺序执行。只要有一个工作项没能返回,这条线程就被永久占住,其后每一个测试的 Dispatch 都会
  无限期排队 —— 表现为「单独跑秒过,一起跑永远卡住」,而且卡的是谁只取决于执行顺序。

  没有超时的话,这种情况会让整个 run 挂死(实测跑一天也不出结果),连是哪个测试卡的都看不出来。
  有了超时,它退化成「那一条测试失败」,其余照常跑完,堵点也直接point 出来。

  60 秒对本仓最慢的用例(headless 渲染 + 像素回归)仍有数量级余量。
-->
<RunSettings>
  <MSTest>
    <!-- 单个测试的默认上限(毫秒);方法上显式的 [Timeout] 优先。 -->
    <TestTimeout>60000</TestTimeout>
  </MSTest>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- 测试一律不碰系统密钥链(MasterKeyStores.DisableEnvironmentVariable):在 macOS / Linux 桌面上跑测试,
           不该往开发者的钥匙串 / keyring 里写条目,也不该弹解锁框把整套用例卡住。
           真密钥链的用例是另一类(SystemKeychain),要显式设 VELASHELL_KEYCHAIN_TESTS=1 才跑。 -->
      <VELASHELL_NO_KEYCHAIN>1</VELASHELL_NO_KEYCHAIN>
      <!-- SonnetDB 不做逐次写入的落盘同步(SonnetDbEngine.NoFsyncEnvironmentVariable):Windows runner 上一次
           FlushFileBuffers 极慢,每条用例都新开一个库的测试类比 Linux 慢 10–40 倍。写入仍交给操作系统,
           关库重开读到的是同一份数据;放弃的只是掉电持久性,没有用例验它。生产默认开着,由
           SonnetDbEngineOptionsTests 钉住。 -->
      <VELASHELL_NO_DB_FSYNC>1</VELASHELL_NO_DB_FSYNC>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
