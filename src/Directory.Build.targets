<Project>
	<!-- 必须显式导入上层的 Directory.Build.targets:本文件的存在会让 MSBuild 不再自动去找上一层,
	     不导入就等于把根目录那条「禁止在 csproj 里写死 TargetFramework」的校验悄悄关掉了。 -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

	<!--
	  Host-owned Avalonia alignment. The host package versions in this repository are the
	  release contract; the SDK does not publish an Avalonia pin. Check the resolved
	  compile references as well as the central package declarations so a transitive
	  dependency cannot silently select a different shared assembly.
	-->
	<Target Name="VerifyHostAvaloniaVersions" AfterTargets="ResolveAssemblyReferences"
	        Condition="'$(VelaSkipAvaloniaVersionCheck)' != 'true'">
		<PropertyGroup>
			<_VelaHostAvaloniaVersion>@(PackageVersion->WithMetadataValue('Identity','Avalonia')->'%(Version)')</_VelaHostAvaloniaVersion>
			<_VelaHostAvaloniaEditVersion>@(PackageVersion->WithMetadataValue('Identity','Avalonia.AvaloniaEdit')->'%(Version)')</_VelaHostAvaloniaEditVersion>
		</PropertyGroup>
		<ItemGroup>
			<_VelaHostAvaloniaRef Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Avalonia'" />
			<_VelaHostAvaloniaEditRef Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Avalonia.AvaloniaEdit'" />
		</ItemGroup>
		<Error Condition="'$(_VelaHostAvaloniaVersion)' == ''"
		       Code="VELA1000"
		       Text="The host must declare its Avalonia version in src/Directory.Packages.props." />
		<Error Condition="'@(_VelaHostAvaloniaRef)' != '' and '%(_VelaHostAvaloniaRef.NuGetPackageVersion)' != '$(_VelaHostAvaloniaVersion)'"
		       Code="VELA1000"
		       Text="The host resolves Avalonia %(_VelaHostAvaloniaRef.NuGetPackageVersion), but src/Directory.Packages.props declares $(_VelaHostAvaloniaVersion)." />
		<Error Condition="'@(_VelaHostAvaloniaEditRef)' != '' and '%(_VelaHostAvaloniaEditRef.NuGetPackageVersion)' != '$(_VelaHostAvaloniaEditVersion)'"
		       Code="VELA1001"
		       Text="The host resolves AvaloniaEdit %(_VelaHostAvaloniaEditRef.NuGetPackageVersion), but src/Directory.Packages.props declares $(_VelaHostAvaloniaEditVersion)." />
	</Target>
</Project>
