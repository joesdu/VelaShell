<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:aer="using:AvaloniaEdit.Rendering"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        mc:Ignorable="d" d:DesignWidth="1128" d:DesignHeight="788"
        x:Class="VelaShell.Views.RemoteFileEditorView"
        Width="1160" Height="820"
        MinWidth="528" MinHeight="368"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

  <!-- SFTP「打开」的内置快速文本编辑器(AvaloniaEdit):远程文件已下载到本地临时副本,
       Ctrl+S / 保存按钮写盘并上传回服务器。外壳沿用标准弹窗规格。 -->

  <Window.Styles>
    <!-- 网址/邮箱链接:AvaloniaEdit 缺省是纯蓝(#0000FF),压在暗色底上几乎读不出来。
         改用信息色令牌 —— 随主题切换实时变化(Dracula 青 / Alucard 深青蓝 / 其余主题各自的 Info)。 -->
    <Style Selector="aer|TextView">
      <Setter Property="LinkTextForegroundBrush" Value="{DynamicResource VelaInfo}" />
    </Style>
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.dlg-primary">
      <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentForeground}" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </Window.Styles>

  <Border Classes="window-card"
          Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,32">

      <!-- 标题栏(28,与全部窗口一致;可拖动,双击最大化/还原):文件名 + 最大化/关闭。
           远端路径与保存按钮在下面一行。 -->
      <Border Grid.Row="0" Padding="20,0,12,0"
              Classes="window-titlebar"
              Background="Transparent"
              PointerPressed="Header_PointerPressed"
              DoubleTapped="Header_DoubleTapped">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- 让位块只在 macOS 上显出来,给系统红绿灯让位(Themes/WindowChrome.axaml)。 -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Panel Classes="traffic-light-spacer" />
            <pc:LucideIcon Width="15" Height="15"
                           Data="{DynamicResource Icon.file-text}"
                           Foreground="{DynamicResource VelaAccent}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
          </StackPanel>
          <TextBlock Grid.Column="1" Name="TitleText"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource VelaTextPrimary}"
                     FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="chrome window-caption" Click="Maximize_Click" ToolTip.Tip="{loc:Localize Editor_MaximizeTip}">
              <pc:LucideIcon Width="13" Height="13"
                             Data="{DynamicResource Icon.maximize}"
                             Foreground="{DynamicResource VelaTextTertiary}" />
            </Button>
            <Button Classes="chrome window-caption" Click="Close_Click">
              <pc:LucideIcon Width="13" Height="13"
                             Data="{DynamicResource Icon.x}"
                             Foreground="{DynamicResource VelaTextTertiary}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 路径行:远端路径 + 保存。同样可拖动。 -->
      <Border Grid.Row="1" Padding="20,6"
              Background="Transparent"
              PointerPressed="Header_PointerPressed"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="PathText"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource VelaTextMuted}"
                     FontFamily="{DynamicResource VelaUiMonoFont}"
                     FontSize="{DynamicResource VelaFontSize10}"
                     TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" Classes="dlg-primary" Click="Save_Click" ToolTip.Tip="Ctrl+S">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <pc:LucideIcon Width="12" Height="12"
                             Data="{DynamicResource Icon.save}"
                             Foreground="{DynamicResource VelaAccentForeground}" />
              <TextBlock Text="{loc:Localize Save}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- 编辑器 -->
      <Border Grid.Row="2" Background="{DynamicResource VelaBgSftpPanel}">
        <ae:TextEditor Name="Editor"
                       FontFamily="{DynamicResource VelaUiMonoFont}"
                       FontSize="{DynamicResource VelaFontSize13}"
                       ShowLineNumbers="True"
                       Background="Transparent"
                       Foreground="{DynamicResource VelaTextPrimary}"
                       LineNumbersForeground="{DynamicResource VelaTextMuted}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       Padding="8,6" />
      </Border>

      <!-- 状态栏 + 右下角缩放角 -->
      <Border Grid.Row="3" Padding="20,0,6,0"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="StatusText"
                     Foreground="{DynamicResource VelaTextMuted}"
                     FontFamily="{DynamicResource VelaUiMonoFont}"
                     FontSize="{DynamicResource VelaFontSize10}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <!-- 右下角缩放手柄;系统自带边缘缩放时(macOS、Wayland)与最大化时由 WindowChrome 隐去。 -->
          <Border x:Name="ResizeGrip" Grid.Column="1" Width="18" Height="18"
                  Background="Transparent"
                  Cursor="BottomRightCorner"
                  PointerPressed="ResizeGrip_PointerPressed">
            <pc:LucideIcon Width="10" Height="10"
                           Data="{DynamicResource Icon.chevron-right}"
                           Foreground="{DynamicResource VelaTextMuted}"
                           RenderTransform="rotate(45deg)"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
