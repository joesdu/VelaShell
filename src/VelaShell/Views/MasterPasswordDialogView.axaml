<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:behaviors="using:VelaShell.Behaviors"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        mc:Ignorable="d" d:DesignWidth="440"
        x:Class="VelaShell.Views.MasterPasswordDialogView"
        x:DataType="vm:MasterPasswordDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!-- 主密码对话框(解锁 / 开启 / 修改 / 关闭 / 抄恢复码 / 恢复后设新密码 / 忘记):外壳与诊断包、设置导出那几个对话框同一规格 ——
       bg-surface 卡片、28px 标题栏、52px 按钮栏;动作按钮按 DESIGN.md §5.1 走两套共享主题,破坏性的(忘记、关闭)是红框的轮廓按钮。
       口令框走 SecurePasswordBox(不进剪贴板、不进历史)。 -->

  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaDangerHover}" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>
    <Style Selector="TextBlock.field-hint">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaError}" />
    </Style>
  </Window.Styles>

  <Border Classes="window-card"
          Background="{DynamicResource VelaBgSurface}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,52">

      <!-- 标题栏(28,可拖动):锁形图标 + 标题 | 关闭 -->
      <Border Grid.Row="0" Classes="window-titlebar" Padding="20,0,0,0"
              PointerPressed="Header_PointerPressed"
              Background="Transparent"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource VelaBorderPrimary}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <pc:LucideIcon Grid.Column="0" Width="15" Height="15"
                         Data="{StaticResource Icon.lock}"
                         Foreground="{DynamicResource VelaAccent}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding Title}"
                     Foreground="{DynamicResource VelaTextPrimary}"
                     FontSize="{DynamicResource VelaFontSize13}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="caption caption-close" VerticalAlignment="Top"
                  AutomationProperties.Name="{loc:Localize Cancel}"
                  Click="Cancel_Click">
            <pc:LucideIcon Width="12" Height="12"
                           Data="{StaticResource Icon.x}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="20,16" Spacing="10">
        <TextBlock Classes="field-hint" Text="{Binding Description}" />
        <TextBlock x:Name="ProblemText" Classes="field-hint"
                   Foreground="{DynamicResource VelaWarning}"
                   Text="{Binding ProblemText}"
                   IsVisible="{Binding HasProblem}" />

        <!-- 主密码 / 当前主密码 -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowsPassword}">
          <TextBlock Classes="field-label" Text="{Binding PasswordLabel}" />
          <TextBox x:Name="PasswordBox"
                   behaviors:SecurePasswordBox.Enabled="True"
                   behaviors:EnglishInputLocale.Enabled="True"
                   behaviors:SecurePasswordBox.Password="{Binding Password}"
                   AutomationProperties.Name="{Binding PasswordLabel}"
                   IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <!-- 恢复码 -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowsRecoveryInput}">
          <TextBlock Classes="field-label" Text="{loc:Localize MasterPassword_RecoveryCodeLabel}" />
          <TextBox x:Name="RecoveryCodeBox" Text="{Binding RecoveryCodeInput}"
                   FontFamily="{DynamicResource VelaUiMonoFont}"
                   AutomationProperties.Name="{loc:Localize MasterPassword_RecoveryCodeLabel}"
                   IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <!-- 新主密码 + 再输一次 -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowsNewPassword}">
          <TextBlock Classes="field-label" Text="{loc:Localize MasterPassword_NewPasswordLabel}" />
          <TextBox x:Name="NewPasswordBox"
                   behaviors:SecurePasswordBox.Enabled="True"
                   behaviors:EnglishInputLocale.Enabled="True"
                   behaviors:SecurePasswordBox.Password="{Binding NewPassword}"
                   AutomationProperties.Name="{loc:Localize MasterPassword_NewPasswordLabel}"
                   IsEnabled="{Binding !IsBusy}" />
          <TextBlock Classes="field-label" Margin="0,6,0,0" Text="{loc:Localize MasterPassword_ConfirmPasswordLabel}" />
          <TextBox x:Name="ConfirmPasswordBox"
                   behaviors:SecurePasswordBox.Enabled="True"
                   behaviors:EnglishInputLocale.Enabled="True"
                   behaviors:SecurePasswordBox.Password="{Binding ConfirmPassword}"
                   AutomationProperties.Name="{loc:Localize MasterPassword_ConfirmPasswordLabel}"
                   IsEnabled="{Binding !IsBusy}" />
          <TextBlock Classes="field-hint" Text="{loc:Localize MasterPassword_StrengthHint}"
                     Foreground="{DynamicResource VelaWarning}" IsVisible="{Binding IsWeak}" />
          <TextBlock Classes="field-hint" Text="{loc:Localize MasterPassword_AsciiNote}" />
        </StackPanel>

        <!-- 开启时:恢复码 + 确认「忘了就无法找回」 -->
        <StackPanel Spacing="6" IsVisible="{Binding ShowsEnableOptions}">
          <TextBlock Classes="field-hint" Foreground="{DynamicResource VelaWarning}"
                     Text="{loc:Localize MasterPassword_EnableWarning}" />
          <CheckBox x:Name="CreateRecoveryCheck" IsChecked="{Binding CreateRecoveryCode}">
            <TextBlock Text="{loc:Localize MasterPassword_CreateRecoveryLabel}" TextWrapping="Wrap"
                       FontSize="{DynamicResource VelaFontSize12}" />
          </CheckBox>
          <CheckBox x:Name="AcknowledgeCheck" IsChecked="{Binding AcknowledgeNoBackdoor}">
            <TextBlock Text="{loc:Localize MasterPassword_AcknowledgeLabel}" TextWrapping="Wrap"
                       FontSize="{DynamicResource VelaFontSize12}" />
          </CheckBox>
        </StackPanel>

        <!-- 抄恢复码:只显示这一次;只读、可选中(要抄下来),不自动放进剪贴板 -->
        <Border Padding="12,10" CornerRadius="6" IsVisible="{Binding ShowsRecoveryDisplay}"
                Background="{DynamicResource VelaBgInput}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1">
          <SelectableTextBlock x:Name="RecoveryCodeText" Text="{Binding RecoveryCodeDisplay}"
                               FontFamily="{DynamicResource VelaUiMonoFont}"
                               FontSize="{DynamicResource VelaFontSize14}"
                               Foreground="{DynamicResource VelaTextPrimary}"
                               HorizontalAlignment="Center" />
        </Border>

        <!-- 解锁框底部:用恢复码 / 忘了主密码 -->
        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding ShowsUnlockLinks}">
          <Button x:Name="UseRecoveryButton" Classes="link"
                  Content="{Binding RecoveryToggleText}"
                  IsVisible="{Binding HasRecoveryCodeOnFile}"
                  Click="ToggleRecovery_Click" />
          <Button x:Name="ForgotButton" Classes="link"
                  Content="{loc:Localize MasterPassword_Forgot}"
                  Click="Forgot_Click" />
        </StackPanel>

        <!-- 错误 / 等待 / 忙碌 -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <pc:CircularProgressRing Width="13" Height="13" StrokeThickness="2" IsIndeterminate="True"
                                   TrackBrush="{DynamicResource VelaBorderSecondary}"
                                   ArcBrush="{DynamicResource VelaAccent}" VerticalAlignment="Center" />
          <TextBlock Classes="field-hint" Text="{loc:Localize MasterPassword_Busy}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Classes="field-hint"
                   Foreground="{DynamicResource VelaError}"
                   Text="{Binding ErrorText}"
                   IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- 按钮栏:取消 / 确定 -->
      <Border Grid.Row="2" Padding="20,0"
              BorderBrush="{DynamicResource VelaBorderPrimary}"
              BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="CancelButton"
                  Theme="{DynamicResource VelaOutlineButtonTheme}"
                  IsCancel="True"
                  Content="{Binding CancelText}"
                  IsVisible="{Binding !ShowsRecoveryDisplay}"
                  Click="Cancel_Click" />
          <Button x:Name="DangerButton"
                  Theme="{DynamicResource VelaOutlineButtonTheme}"
                  Classes="danger"
                  Content="{Binding ConfirmText}"
                  IsVisible="{Binding IsDestructive}"
                  IsEnabled="{Binding CanConfirm}"
                  Click="Confirm_Click" />
          <Button x:Name="ConfirmButton"
                  Theme="{DynamicResource VelaAccentPillButtonTheme}"
                  Height="28"
                  IsDefault="True"
                  IsVisible="{Binding !IsDestructive}"
                  IsEnabled="{Binding CanConfirm}"
                  Click="Confirm_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <pc:LucideIcon Width="13" Height="13"
                             Data="{StaticResource Icon.lock-open}"
                             Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding ConfirmText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
