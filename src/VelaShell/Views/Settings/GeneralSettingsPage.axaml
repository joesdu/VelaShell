<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:loc="using:VelaShell.Localization"
             x:Class="VelaShell.Views.Settings.GeneralSettingsPage"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="page-title" Text="{loc:Localize SetGeneral_Title}" />
      <TextBlock Classes="page-subtitle" Text="{loc:Localize SetGeneral_Subtitle}" />
    </StackPanel>

    <!-- 启动与窗口 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_StartupSection}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_LaunchAtStartup}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_LaunchAtStartupDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.LaunchAtStartup}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_RestoreSessions}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_RestoreSessionsDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.RestoreSessionsOnStartup}" VerticalAlignment="Center" />
    </Grid>
    <!-- 按上次的分屏恢复:只在开了恢复会话时有意义,关着就置灰。默认关 —— 关着时恢复会话照旧逐条重连进一个窗格。 -->
    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding General.RestoreSessionsOnStartup}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_RestoreLayout}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_RestoreLayoutDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.RestoreLayoutOnStartup}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_MinimizeToTray}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_MinimizeToTrayDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.MinimizeToTray}" VerticalAlignment="Center" />
    </Grid>
    <!-- 「启动时检查更新」恢复展示:它此前被判为"更新服务尚未接入"而隐藏(设置审计 R-01),
         但这个开关已经有实际消费者 —— 消息中心据它决定要不要在启动时查一次新版本。
         更新频道在关于页。 -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_CheckUpdatesOnStartup}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_CheckUpdatesOnStartupDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.CheckUpdatesOnStartup}" VerticalAlignment="Center" />
    </Grid>
    <!-- 「自动下载更新」挂在启动检查上:检查关着就没有可下的东西,开关跟着置灰。
         只在能原地换版的安装上出现(CanSelfUpdate:Linux、商店版与只读目录为假)——
         那几种安装上它什么也不会做,摆出来就是又一个"界面在骗人"(设置审计 R-03)。 -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanSelfUpdate}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_AutoDownloadUpdates}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_AutoDownloadUpdatesDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.AutoDownloadUpdates}"
                    IsEnabled="{Binding General.CheckUpdatesOnStartup}" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 消息中心(侧边栏铃铛) -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_MessagesSection}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_NotifyUpdates}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_NotifyUpdatesDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Notifications.NotifyUpdates}" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Spacing="4">
      <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_FeedUrl}" />
      <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_FeedUrlDesc}" />
      <TextBox Text="{Binding Notifications.FeedUrl}"
               PlaceholderText="{loc:Localize SetGeneral_FeedUrlPlaceholder}" />
    </StackPanel>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_FeedInterval}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_FeedIntervalDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="168" Increment="1"
                     FormatString="0"
                     Value="{Binding Notifications.FeedIntervalHours}"
                     VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_AllowPromotions}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_AllowPromotionsDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Notifications.AllowPromotions}" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 语言与区域 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_LanguageSection}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize Language}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_UiLanguageDesc}" />
      </StackPanel>
      <!-- 条目顺序必须与 SettingsViewModel.AvailableLanguages 一致;首项「跟随系统」随界面语言翻译,
           其余语言名用各语言本名(任何界面语言下都能认出自己的语言)。 -->
      <ComboBox Grid.Column="1" Width="160" SelectedIndex="{Binding LanguageIndex}" VerticalAlignment="Center">
        <ComboBoxItem Content="{loc:Localize SetGeneral_LanguageSystem}" />
        <ComboBoxItem Content="简体中文" />
        <ComboBoxItem Content="English" />
        <ComboBoxItem Content="繁體中文" />
        <ComboBoxItem Content="日本語" />
        <ComboBoxItem Content="한국어" />
      </ComboBox>
    </Grid>

    <Border Classes="sep" />

    <!-- 连接默认值 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_ConnectionDefaultsSection}" />
    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
        <TextBlock Classes="row-label" FontSize="{DynamicResource VelaFontSize11}" Text="{loc:Localize DefaultPort}" />
        <NumericUpDown Width="NaN" HorizontalAlignment="Stretch" Value="{Binding DefaultPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="2" Spacing="5">
        <TextBlock Classes="row-label" FontSize="{DynamicResource VelaFontSize11}" Text="{loc:Localize SetGeneral_ConnectTimeout}" />
        <NumericUpDown Width="NaN" HorizontalAlignment="Stretch" Value="{Binding General.ConnectTimeoutSeconds}" Minimum="1" Maximum="600" Increment="5" FormatString="0" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5">
        <TextBlock Classes="row-label" FontSize="{DynamicResource VelaFontSize11}" Text="{loc:Localize SetGeneral_KeepAliveInterval}" />
        <NumericUpDown Width="NaN" HorizontalAlignment="Stretch" Value="{Binding General.KeepAliveSeconds}" Minimum="0" Maximum="600" Increment="10" FormatString="0" />
      </StackPanel>
    </Grid>

    <Border Classes="sep" />

    <!-- 数据与存储 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_DataSection}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_SessionLogging}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_SessionLoggingDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.SessionLogging}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding General.SessionLogging}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_LogRetentionDays}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_LogRetentionDaysDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="80" Value="{Binding General.LogRetentionDays}" Minimum="1" Maximum="365" Increment="1" FormatString="0" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_ImportExport}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_ImportExportDesc}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="dlg-outline" Content="{loc:Localize SetGeneral_Export}" Click="ExportSettings_Click" />
        <Button Classes="dlg-outline" Content="{loc:Localize SetGeneral_Import}" Click="ImportSettings_Click" />
      </StackPanel>
    </Grid>
    <!-- 导入/导出的结果回显:这两个动作以前全程无声,坏文件和写盘失败都看不见。 -->
    <TextBlock Classes="row-desc" TextWrapping="Wrap"
               Text="{Binding ImportExportStatus}"
               IsVisible="{Binding ImportExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Border Classes="sep" />

    <!-- 行为 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_BehaviorSection}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_ConfirmBeforeClose}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_ConfirmBeforeCloseDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.ConfirmBeforeClose}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_ConfirmCloseTab}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_ConfirmCloseTabDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.ConfirmCloseConnectedTab}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_StatusMetricsInterval}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_StatusMetricsIntervalDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="100"
                     Value="{Binding General.StatusMetricsIntervalSeconds}"
                     Minimum="1" Maximum="60" Increment="1" FormatString="0"
                     VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_FollowActiveTerminal}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_FollowActiveTerminalDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1"
                    IsChecked="{Binding General.FollowActiveTerminalInExplorer}"
                    VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_CollapseGroups}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_CollapseGroupsDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1"
                    IsChecked="{Binding General.CollapseGroupsByDefault}"
                    VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_NotifyOnDisconnect}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_NotifyOnDisconnectDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.NotifyOnDisconnect}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_SoundOnDisconnect}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_SoundOnDisconnectDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.SoundAlerts}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_AutoReconnect}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_AutoReconnectDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.AutoReconnect}" VerticalAlignment="Center" />
    </Grid>
    <!-- 自动重连的从属设置:父项关闭时隐藏,已保存值保留(设置审计 §10)。 -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding General.AutoReconnect}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_MaxRetries}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_MaxRetriesDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="80" Value="{Binding General.MaxRetries}" Minimum="1" Maximum="20" Increment="1" FormatString="0" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding General.AutoReconnect}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_ReconnectInterval}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_ReconnectIntervalDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="80" Value="{Binding General.ReconnectIntervalSeconds}" Minimum="1" Maximum="300" Increment="1" FormatString="0" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 隐私与安全 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetGeneral_PrivacySection}" />
    <!-- 主密码(设置审计 R-04):可选的第二层,默认关。开着时本机加密密钥用主密码再包一层(系统密钥链 / DPAPI 密钥文件里的条目
         与主密码两样都在才解得开);状态现问主密码服务(事实来源是包裹格式,不是设置里的开关)。按钮按状态出现:
         没开 → 开启…;开着 → 解锁… / 立即锁定、修改…、关闭…(红框,DESIGN.md §5.1)。 -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MasterPasswordSettings.IsAvailable}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_MasterPassword}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_MasterPasswordDesc}" />
        <TextBlock x:Name="MasterPasswordStatus" Classes="row-desc" Text="{Binding MasterPasswordSettings.StatusText}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="MasterPasswordEnableButton" Classes="dlg-primary" Content="{loc:Localize SetGeneral_MasterPasswordEnable}"
                IsVisible="{Binding !MasterPasswordSettings.IsEnabled}" Click="MasterPasswordEnable_Click" />
        <Button Classes="dlg-outline" Content="{loc:Localize SetGeneral_MasterPasswordUnlock}"
                IsVisible="{Binding MasterPasswordSettings.IsLocked}" Click="MasterPasswordUnlock_Click" />
        <Button Classes="dlg-outline" Content="{loc:Localize SetGeneral_MasterPasswordLockNow}"
                IsVisible="{Binding MasterPasswordSettings.IsUnlocked}" Click="MasterPasswordLockNow_Click" />
        <Button Classes="dlg-outline" Content="{loc:Localize SetGeneral_MasterPasswordChange}"
                IsVisible="{Binding MasterPasswordSettings.IsEnabled}" Click="MasterPasswordChange_Click" />
        <Button Classes="dlg-danger" Content="{loc:Localize SetGeneral_MasterPasswordDisable}"
                IsVisible="{Binding MasterPasswordSettings.IsEnabled}" Click="MasterPasswordDisable_Click" />
      </StackPanel>
    </Grid>
    <TextBlock Classes="row-desc"
               Text="{Binding MasterPasswordSettings.Notice}"
               IsVisible="{Binding MasterPasswordSettings.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <!-- 自动锁定:新设置项当场接线(MasterPasswordAutoLock)。主密码没开时不起作用,照样可以先设好。 -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MasterPasswordSettings.IsAvailable}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_AutoLock}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_AutoLockDesc}" />
      </StackPanel>
      <NumericUpDown Grid.Column="1" Width="80" Value="{Binding General.MasterPasswordAutoLockMinutes}"
                     Minimum="0" Maximum="1440" Increment="5" FormatString="0" VerticalAlignment="Center" />
    </Grid>
    <!-- 系统锁屏时锁定:只在读得到锁屏状态的平台上显示(目前是 Windows),免得开了却不起作用。 -->
    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MasterPasswordSettings.SystemLockSupported}">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_LockOnSystemLock}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_LockOnSystemLockDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.MasterPasswordLockOnSystemLock}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_RememberPasswords}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_RememberPasswordsDesc}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding General.RememberPasswords}" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetGeneral_ClearHistory}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetGeneral_ClearHistoryDesc}" />
      </StackPanel>
      <!-- 破坏性操作:点击后先弹确认框(代码后置),确认才执行(设置审计 §12)。 -->
      <Button Grid.Column="1" Classes="dlg-danger" Content="{loc:Localize SetGeneral_Clear}"
              Click="ClearHistory_Click" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Classes="row-desc"
               Text="{Binding ClearHistoryStatus}"
               IsVisible="{Binding ClearHistoryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
