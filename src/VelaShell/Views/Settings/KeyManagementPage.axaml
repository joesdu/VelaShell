<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:ssh="clr-namespace:VelaShell.Core.Ssh;assembly=VelaShell.Core"
             xmlns:loc="using:VelaShell.Localization"
             x:Class="VelaShell.Views.Settings.KeyManagementPage"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="page-title" Text="{loc:Localize SetKeys_Title}" />
      <TextBlock Classes="page-subtitle" Text="{loc:Localize SetKeys_Subtitle}" />
    </StackPanel>

    <!-- 工具栏 -->
    <Grid ColumnDefinitions="200,*,Auto,8,Auto,8,Auto">
      <TextBox Grid.Column="0" Text="{Binding SshKeys.SearchQuery}" PlaceholderText="{loc:Localize SetKeys_SearchPlaceholder}" />
      <!-- 生成算法。**这串条目的顺序必须与 SshKeyManagerViewModel.AlgorithmChoices 一一对应** ——
           那边才是唯一事实来源,这里只按同样顺序摆文案、用 SelectedIndex 对齐。错位的后果是
           用户选 Ed25519 拿到一把 RSA 且界面看不出异常,所以 SshKeyChoiceCatalogTests 会读本文件
           逐项比对;要增删档位,先改 AlgorithmChoices。 -->
      <ComboBox Grid.Column="2" Width="150" VerticalAlignment="Center"
                Name="AlgorithmSelector"
                ToolTip.Tip="{loc:Localize SetKeys_Algorithm}"
                AutomationProperties.Name="{loc:Localize SetKeys_Algorithm}"
                SelectedIndex="{Binding SshKeys.SelectedAlgorithmIndex}">
        <ComboBoxItem Content="{loc:Localize SetKeys_AlgoEd25519}" />
        <ComboBoxItem Content="{loc:Localize SetKeys_AlgoEcdsa256}" />
        <ComboBoxItem Content="{loc:Localize SetKeys_AlgoEcdsa384}" />
        <ComboBoxItem Content="{loc:Localize SetKeys_AlgoEcdsa521}" />
        <ComboBoxItem Content="{loc:Localize SetKeys_AlgoRsa4096}" />
      </ComboBox>
      <Button Grid.Column="4" Classes="dlg-outline" Content="{loc:Localize SetKeys_Import}" Click="ImportKey_Click" />
      <Button Grid.Column="6" Classes="dlg-primary" Content="{loc:Localize SetKeys_Generate}"
              Command="{Binding SshKeys.GenerateCommand}" />
    </Grid>

    <!-- 密钥表格 -->
    <Border Classes="table">
      <StackPanel>
        <!-- 表头 -->
        <Border Height="36" Background="{DynamicResource VelaBgSidebar}"
                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1"
                Padding="12,0">
          <Grid ColumnDefinitions="130,80,*,60">
            <TextBlock Text="{loc:Localize Name}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{loc:Localize KeyType}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{loc:Localize Fingerprint}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{loc:Localize SetSync_Actions}" Foreground="{DynamicResource VelaTextMuted}" FontSize="{DynamicResource VelaFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding SshKeys.FilteredKeys}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ssh:SshKeyInfo">
              <Border Height="40" Padding="12,0"
                      BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="130,80,*,60">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Width="13" Height="13"
                              Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                              Foreground="{DynamicResource VelaAccent}" />
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource VelaTextPrimary}"
                               FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize11}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Type}"
                             Foreground="{DynamicResource VelaTextSecondary}"
                             FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize10}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Fingerprint}"
                             Foreground="{DynamicResource VelaTextMuted}"
                             FontFamily="{DynamicResource VelaUiMonoFont}" FontSize="{DynamicResource VelaFontSize10}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Width="24" Height="24" Padding="0" Background="Transparent"
                            CornerRadius="3" Cursor="Hand"
                            ToolTip.Tip="{loc:Localize SetKeys_CopyPublicKey}"
                            Click="CopyPublicKey_Click">
                      <PathIcon Width="13" Height="13"
                                Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                Foreground="{DynamicResource VelaTextTertiary}" />
                    </Button>
                    <!-- 破坏性操作:删的是 ~/.ssh 下真实的私钥与公钥,别的工具(git、
                         ansible、云控制台)多半也在用同一把。先弹确认(设置审计 §12)。 -->
                    <Button Width="24" Height="24" Padding="0" Background="Transparent"
                            CornerRadius="3" Cursor="Hand"
                            ToolTip.Tip="{loc:Localize SetKeys_DeleteKey}"
                            Click="DeleteKey_Click">
                      <PathIcon Width="13" Height="13"
                                Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                Foreground="{DynamicResource VelaTextTertiary}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 提示 -->
    <StackPanel Orientation="Horizontal" Spacing="6">
      <PathIcon Width="12" Height="12"
                Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                Foreground="{DynamicResource VelaTextMuted}" VerticalAlignment="Center" />
      <TextBlock Classes="row-desc" Text="{loc:Localize SetKeys_StorageHint}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Classes="row-desc"
               Text="{Binding SshKeys.StatusMessage}"
               IsVisible="{Binding SshKeys.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Border Classes="sep" />

    <!-- 默认密钥 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetKeys_SectionDefault}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetKeys_DefaultAuthKey}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetKeys_DefaultAuthKeyDesc}" />
      </StackPanel>
      <ComboBox Grid.Column="1" Width="160"
                ItemsSource="{Binding SshKeys.KeyNames}"
                SelectedItem="{Binding Keys.DefaultKeyName}"
                VerticalAlignment="Center" />
    </Grid>

    <Border Classes="sep" />

    <!-- 自动加载密钥到 Agent(设置审计 R-06):私钥文件认证成功后把钥加进本机 ssh-agent。
         默认关 —— 往系统 agent 里放私钥是用户的决定,Windows 的 agent 还会跨重启保留。 -->
    <TextBlock Classes="section-title" Text="{loc:Localize SetKeys_SectionAgent}" />
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="row-label" Text="{loc:Localize SetKeys_AddKeysToAgent}" />
        <TextBlock Classes="row-desc" Text="{loc:Localize SetKeys_AddKeysToAgentDesc}" TextWrapping="Wrap" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Keys.AddKeysToAgent}" VerticalAlignment="Center" />
    </Grid>
  </StackPanel>
</UserControl>
