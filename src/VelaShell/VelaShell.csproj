<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win32 版本资源:AssemblyTitle → FileDescription(任务管理器、文件属性与安全软件
         弹窗里显示的那一行,此前是裸的程序集名 "VelaShell"),Description → Comments。
         刻意用英文并与 build/msix/AppxManifest.template.xml 的 Description 逐字一致:
         这几个字段是给 Windows 与杀软厂商的分析员看的,商店版与便携版说的得是同一句话。
         其余字段(Company/Product/Copyright)在仓库根 Directory.Build.props,见 #299。 -->
    <AssemblyTitle>VelaShell SSH / SFTP Terminal Client</AssemblyTitle>
    <Description>A modern, cross-platform SSH and SFTP client with a GPU-accelerated terminal.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\velashell.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- 语法高亮定义(AvaloniaEdit 未内置的那几种)。用 EmbeddedResource 而非 AvaloniaResource:
         HighlightingLoader 要的是普通 Stream,由 Assembly.GetManifestResourceStream 提供。
         资源名 = "VelaShell.Syntax.<文件名>",与 SyntaxHighlightingService 里的常量对应。 -->
    <EmbeddedResource Include="Syntax\*.xshd" />
  </ItemGroup>

  <!--
    Release 发布形态:自包含、摊开(**刻意不用 PublishSingleFile**)。

    2026-08-12 起从单文件改回摊开发布,起因是插件系统:隔离模式插件由主程序拉起
    VelaShell.PluginHost 进程(见 Plugins/Isolated/PluginProcessClient),单文件会把
    PluginHost 的托管程序集连同整套运行时一起打进 VelaShell.exe 的 bundle,磁盘上根本没有
    可执行体 —— 打包版里隔离插件必然拉不起宿主。要么让第二个进程各带一套运行时(包体近乎
    翻倍),要么摊开发布让两个可执行体共用同一份运行时;选后者。

    连带影响是自更新:换版原先靠"复制新版单文件到临时目录当更新器"。摊开发布后单个 exe
    离开应用目录就跑不起来,改为直接运行暂存目录里那份完整的新版应用当更新器,换版也随之
    从"移动"改为"复制"(见 Services/Update/UpdateApplier)。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      ReadyToRun:把托管程序集预编译成本机代码随包分发,用户机器上不必再从零 JIT。
      受益的是**每一次冷启动**,而且这里有两个可执行体都吃到:主程序,以及隔离插件的宿主
      VelaShell.PluginHost(它是 ProjectReference,同一次 publish 一并 R2R)——
      后者的冷启动此前实测约 1 秒,大头正是运行时 + Avalonia 初始化。

      代价是包体:R2R 的程序集里 IL 与本机代码并存,自包含发布下增长可观。这是已知取舍。

      只在给了 RID 时打开:R2R 必须按目标运行时编译,没有 RID 的 publish 会直接报
      NETSDK1095。发布流水线三个平台都传 -r(且各自跑在对应 OS 的 runner 上 ——
      跨架构可以,跨 OS 不行),本机不带 RID 的 publish 则安静地退回普通发布。

      不开 PublishReadyToRunComposite:复合模式启动更快,但把整个自包含运行时熔成一个
      巨大镜像,包体与构建时间的涨幅都不是这一轮想付的。

      ======================= 2026-09-17:R2R 在 Windows 上未必划算 =======================
      冷启动打点(~/.velashell/logs 的 [Startup] timeline,37 次样本)是干净的两态分布:
      全热 0.96–1.28 s,全冷 6.07–7.63 s。差的这 ~6 秒里,连 BuildServiceProvider 这种
      纯内存操作都慢了 1.8 秒 —— 纯内存操作不会因为"冷"而变慢,慢的只能是它所在的程序集
      第一次装载这件事。

      实测(NVMe + i7-13700,Defender 实时防护开启,发行目录 227 MB / 317 文件):
        · 整目录复制                        188 ms   ← 磁盘完全不是瓶颈
        · 复制到新路径后首次全量读        3,934 ms   ← Defender 首次扫描
        · 同一批文件再读一遍                 87 ms
      按 Authenticode 签名状态拆开,体积几乎相同而代价差 4.4 倍:
        · NotSigned  94 文件 / 113 MB → 3,153 ms   (33.5 ms/文件, 27.9 ms/MB)
        · Valid(微软签的运行时) 207 / 109 MB →  712 ms   ( 3.4 ms/文件,  6.5 ms/MB)
      未签名的那 113 MB 就是 VelaShell.* / Avalonia.* / SonnetDB / BouncyCastle 与 AI 插件。

      R2R 省的是 JIT —— 那是 CPU 时间,冷热两种情况下一样多,碰不到上面这 6 秒。而它把
      未签名程序集的体积几乎翻倍(VelaShell.dll 2.9 MB IL → 8.4 MB 代码段;Avalonia.Base
      2.3 → 7.4 MB;SonnetDB.Core 16 → 21.4 MB),等于直接加钱买 Defender 的扫描时间。
      这正是"开了 R2R 也没见变快"的定量解释:省下的 JIT ≈ 多出来的扫描,净收益接近零。

      ⚠️ 一个容易搞错的地方:Defender 是在**程序集被装载时**扫它,不是启动时把整个目录扫一遍。
      所以启动路径上根本不装载的程序集(BouncyCastle 只在首次 SSH 握手时用、FluentFTP 只在
      FTP 会话里用),它们的 R2R 膨胀**不花冷启动的钱** —— 把它们列进
      PublishReadyToRunExclude 只能省包体和首次连接的 JIT,换不来首帧。因此这里**不**放
      一份凭直觉猜出来的排除清单:那是拿一个未知去换另一个未知。

      真正要回答的是"启动路径上那 ~55 MB 的 R2R 到底值不值",而这个问题有一个**不需要重新
      构建**的判决性实验,用同一份二进制跑(扫描成本因此完全恒定,差值就是纯 JIT):

        # 基线(R2R 生效)
        $env:VELASHELL_STARTUP_TRACE='1'; D:\VelaShell\VelaShell.exe
        # 让运行时忽略 R2R 的本机代码,全部回退到 JIT
        $env:DOTNET_ReadyToRun='0';       D:\VelaShell\VelaShell.exe

      两次都在**热态**下跑(连开两次取第二次),差值即 R2R 省下的 JIT 时间。拿它和
      "R2R 多出来的字节 × 27.9 ms/MB"(当前约 20 MB → ~560 ms)比:
        · JIT 省下的 >  560 ms  → R2R 划算,保持现状;
        · JIT 省下的 <  560 ms  → R2R 在 Windows 上是净亏,用下面的开关关掉再发一版对比。

      下面的 VelaShellReadyToRun 就是为这一步准备的(默认 true,行为与此前一致):
        dotnet publish src/VelaShell -c Release -r win-x64 -p:VelaShellReadyToRun=false
      Linux/macOS 不受这笔账影响(没有 Defender 那一层),真要关也应当只关 Windows 这一支。

      根治仍然是 Authenticode 签名:同样的字节,签过名就从 27.9 ms/MB 掉到个位数,
      而且顺带解决 #299 的报毒。上面这些都只是在没有证书之前把损失压小。
    -->
    <VelaShellReadyToRun Condition="'$(VelaShellReadyToRun)' == ''">true</VelaShellReadyToRun>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' and '$(VelaShellReadyToRun)' == 'true'">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Wayland" />
    <!--
      DevTools 支持包:**只进非 Release 构建**。

      这个 Condition 一直只写在注释里、从没落到元素上(注释是 Avalonia 模板带来的),于是发行包里
      一直躺着 3.1 MB 的 AvaloniaUI.DiagnosticsSupport.Avalonia.dll,VelaShell.runtimeconfig.json
      里的 Avalonia.Diagnostics.Diagnostic.IsEnabled 也一直是 true —— 也就是说 DevTools 在用户
      手上的版本里是开着的。

      冷启动上的账见下面 PublishReadyToRun 处的注释:未签名程序集装载时要过一遍 Defender,
      实测约 27.9 ms/MB 外加每文件 ~33.5 ms 的信誉查询,这 3.1 MB 合计 ~120 ms —— 花在一个
      用户根本用不到的调试面板上。

      本仓库没有任何代码引用 Avalonia.Diagnostics 的 API(它是纯 MSBuild/runtimeconfig 集成),
      因此摘掉不影响 Release 编译。
    -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' != 'Release'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.Avalonia" />
  </ItemGroup>

  <!-- 见 VelaShell.Terminal.csproj 同处注释:签名构建(Release)省略友元声明,非签名构建保留。 -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="VelaShell.Tests" />
  </ItemGroup>

  <!--
    关于页的依赖版本(见 Services/PackageVersions.cs):把 Directory.Packages.props 里 pin 的
    包版本在编译期写进程序集元数据,免得手写版本号跟着漂(它已经漂过一次:关于页停在 12.0.5,
    实际引用早已是 12.1.0)。

    为什么不在运行时读 .deps.json:它记的是程序集版本而非包版本,解析它还得在启动路径上多读
    一个文件、多一套 JSON 结构要维护(该文件曾因单文件发布压根不落盘,如今摊开发布才有,
    这种"随发布形态变化的依赖"本身就不该出现在关于页这种小功能上)。
    为什么不读程序集版本:那与包版本不是一回事 —— SSH.NET 程序集报 2025.1.0.1、
    ReactiveUI 报 23.0.0.0,而包版本是 2025.1.0 / 23.2.28。

    这里把 17 个包全写进去(每条几十字节),而不是只挑关于页当前用到的那两个:
    否则关于页每加一个依赖都得回来改构建脚本,这种隐式耦合迟早被漏掉。
  -->
  <Target Name="EmbedPackageVersions" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'%(PackageVersion.Version)' != ''">
        <_Parameter1>PackageVersion:%(PackageVersion.Identity)</_Parameter1>
        <_Parameter2>%(PackageVersion.Version)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VelaShell.Core\VelaShell.Core.csproj" />
    <ProjectReference Include="..\VelaShell.Terminal\VelaShell.Terminal.csproj" />
    <ProjectReference Include="..\VelaShell.Presentation\VelaShell.Presentation.csproj" />
    <ProjectReference Include="..\VelaShell.Controls\VelaShell.Controls.csproj" />
    <ProjectReference Include="..\VelaShell.Infrastructure\VelaShell.Infrastructure.csproj" />
    <!-- 隔离插件的宿主进程:随应用分发(exe/deps/runtimeconfig 一并进输出目录)。 -->
    <ProjectReference Include="..\VelaShell.PluginHost\VelaShell.PluginHost.csproj" />
    <!-- 仓库内插件(plugins/,当前只有 AI):只建立构建顺序,不引用程序集 —— 保证 F5 时
         插件(含 plugin.json)总是重新构建并镜像进本项目输出的 plugins/ 目录。改了 manifest
         或插件代码不再需要手动先构建插件项目(踩过:输出里留着旧 isolated 清单,Tab 模式"失灵")。
         UndefineProperties:发布命令行上的 -r / -p:SelfContained / -p:PublishSingleFile 是
         全局属性,默认会顺着引用流进插件项目,把插件也当成"自带运行时的单文件应用"来构建
         (输出目录多出一整套运行时,还会跟着 RID 分叉到 bin/<cfg>/net11.0/<rid>/,
         与 GetVelaPluginPayload 按 TargetDir 取件的约定对不上)。插件由宿主的 ALC 装载,
         天然是框架依赖、RID 无关的类库,这里显式把这些属性摘掉,让本机构建与发布构建
         落在同一个输出目录。 -->
    <ProjectReference Include="..\..\plugins\*\*.csproj" ReferenceOutputAssembly="false" Private="false" UndefineProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishAot" />
  </ItemGroup>

  <!--
    ======================== 第一方插件从哪里来 ========================
    两个来源,发行包的 plugins/ 是它们的并集:

    ① 本仓库(plugins/ 下的工程,当前是 AI 插件 velashell.ai)
       上面那条 ProjectReference 建立构建顺序,plugins/Directory.Build.targets 把产物镜像进
       本项目 bin/ 的 plugins/;发布期由下面的 AddVelaPluginsToPublish 调各插件的
       GetVelaPluginPayload 登记进包(是否进包看各插件的 <VelaPluginShip>)。
       AI 插件留在主仓库的原因见 plugins/README.md —— 它与宿主耦合最紧
       (借宿主的 AvaloniaEdit、必须进程内装载、Avalonia 必须逐字同版)。

    ② 第一方插件仓库 joesdu/velashell-plugins(Redis / S3 / Telnet)
       以各插件的 .vpx 包(本项目自有的插件包格式)作为 Release 资产交付,
       容器内布局就是安装后 plugins/<插件>/ 那一层。
       解到 artifacts/plugins/ 作为**暂存目录**,构建与发布都从这里取件。

       ⚠️ 2026-08-22 起②**不再进发行包**:不是每个人都要连 Redis、开 S3、拨 Telnet,
       预装等于给所有人塞三份用不上的依赖,还把发版绑在另一个仓库的发布顺序上。
       用户按需从插件商店(https://market.easilynet.top)装。
       CI 上这个暂存目录压根不存在 —— 下面两个 Target 的 Exists/为空判断因此都会走空分支。
       这里的机制保留是给**本机**用的:想在自己机器上连同那几个插件一起跑,铺进去即可。

    暂存目录怎么来(纯本机手动动作):把插件目录铺进 artifacts/plugins/ 即可 ——
    可以从插件仓库(joesdu/velashell-plugins)的 Release 资产 —— 各插件的 .vpx 包 ——
    解出来,也可以直接指向那边的构建产物;用 -p:VelaPluginsStageDir=<目录> 能改指别处。
    ⚠️ 别把 velashell-ai 也铺进来:①已经产出它了,同一个 id 出现两份会被 PluginManager 判重,
    后来者标 Invalid,表象是"插件莫名其妙用不了"。
  -->
  <PropertyGroup>
    <VelaPluginsStageDir Condition="'$(VelaPluginsStageDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\plugins</VelaPluginsStageDir>
  </PropertyGroup>

  <!-- 开发内环:把暂存目录镜像进本项目输出的 plugins/,F5 即可装载(plugins/ 下的插件走的是
       plugins/Directory.Build.targets 的 CopyVelaPluginToAppOutput,不经过这里)。
       暂存目录不存在就静默跳过 —— 没取过插件的干净克隆照样能构建、能跑,
       只是启动后只有 plugins/ 下的那几个插件。发布路径不接受一个插件都没有,见 AddVelaPluginsToPublish。

       挂 CopyFilesToOutputDirectory 而不是 Build,是为了赶在 IncrementalClean 之前 ——
       下面把复制出去的文件登记进 FileWrites,于是:
         · `dotnet clean` 能把它们清干净(此前清不掉:Copy 不登记就等于没在清理台账上留名,
           表现是"clean 完插件还在",很难往构建产物残留上想);
         · 从暂存目录里删掉一个插件后,下次构建 IncrementalClean 会按上一轮的台账
           把它从输出里剪掉 —— 此前只增不减,删了源头输出里那份能一直留到手动删为止。
       只登记本目标复制的文件:本仓库的插件(velashell-ai)由插件工程自己铺进同一个 plugins/,
       不在这份台账里,因此绝不会被误剪。 -->
  <Target Name="CopyVelaPluginsToOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="Exists('$(VelaPluginsStageDir)')">
    <ItemGroup>
      <_VelaStagedPluginFile Include="$(VelaPluginsStageDir)\**\*" />
      <_VelaStagedPluginOutput Include="@(_VelaStagedPluginFile->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_VelaStagedPluginFile)" DestinationFiles="@(_VelaStagedPluginOutput)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_VelaStagedPluginOutput)" />
    </ItemGroup>
    <!-- IncrementalClean 剪的是文件,剪空的目录会原地留下来。留着不影响运行
         (宿主发现插件要求目录里有 plugin.json,没有就跳过),但 `ls plugins` 看到一个
         早该消失的插件名会让人以为它还装着 —— 那正是这轮要消灭的困惑。
         判据用"没有 plugin.json"而不是"目录为空":对宿主而言这两者等价,
         而前者顺带也清掉了剪剩半截的残骸。 -->
    <ItemGroup>
      <_VelaOutputPluginDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)plugins'))" Condition="Exists('$(OutDir)plugins')" />
      <_VelaOrphanPluginDir Include="@(_VelaOutputPluginDir)" Condition="!Exists('%(Identity)\plugin.json')" />
    </ItemGroup>
    <RemoveDir Directories="@(_VelaOrphanPluginDir)" />
  </Target>

  <!--
    发布期把"随应用分发"的插件放进安装包的 plugins/<目录名>/ —— 运行时的插件发现根之一
    (另一个是用户手动安装目录 ~/.velashell/plugins/,见 PluginServiceCollectionExtensions)。

    为什么必须显式做这件事:publish 只收 ResolvedFileToPublish 里登记过的文件,不扫 bin
    目录 —— 不登记,发行包里就一个插件都没有(上面的 CopyVelaPluginsToOutput 只管 F5)。

    走 ResolvedFileToPublish 而不是 AfterTargets="Publish" 手工拷贝:让 -o / 增量 /
    各 RID 布局都由 SDK 统一处理。ExcludeFromSingleFile 是道保险 —— 当前发布形态已不用
    单文件(见上面 Release 的 PropertyGroup),但插件 dll 必须以磁盘上的真实文件形态存在
    (ALC 要按 deps.json 解析装载),万一哪天有人重新打开单文件,这行能挡住它们被卷进 bundle。

    两个来源在这里汇合(见上面"第一方插件从哪里来"):
      · 本仓库的插件 —— 调各插件工程的 GetVelaPluginPayload,由它按 <VelaPluginShip> 决定进不进包;
      · 取回的分发包 —— 暂存目录里有什么就装什么(那一头由工具链仓库各插件的
        <VelaPluginShip> 把关,示例插件 velashell.hello-world 设了 false,不进包)。
    两边的 plugins/<目录名> 不会重名:取件脚本会把与本仓库插件同名的目录丢掉。

    **必须 AfterTargets 而非 BeforeTargets**(#181,1.2.2 全平台发行包踩过):
    ComputeResolvedFilesToPublishList 的正文里会跑 ResolveOverlappingItemGroupConflicts,
    在 _ResolvedCopyLocalPublishAssets(应用自己的 NuGet 产物)与此刻已有的 ResolvedFileToPublish
    之间消重 —— 而它只按**文件名**判冲突,完全不看 RelativePath。插件目录里凡有与应用根目录
    同名的程序集(AI 插件经 LiveMarkdown.Avalonia 传递引入了 MicroCom.Runtime.dll /
    Avalonia.Remote.Protocol.dll),版本又一样,应用根目录那份就会被判为输家删掉,
    发行包里只剩 plugins/velashell-ai/ 下的那份。后果是 Windows 上 Avalonia.Win32 启动即
    FileNotFoundException: MicroCom.Runtime —— 且只有解压全新包的用户会遇到,应用内更新
    只覆盖清单里的文件、不删多余文件,老版本留下的那份反而把问题掩盖了。
    放到冲突消重之后再登记,两份各就各位、互不相干。下面的
    VerifyVelaAppPublishAssetsIntact 是这条顺序约束的看门狗。
  -->
  <Target Name="AddVelaPluginsToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <!-- ① 本仓库的插件:问每个插件工程要它的发行载荷。
         RemoveProperties 与上面 ProjectReference 的 UndefineProperties 同理 ——
         别让 -r / SelfContained / PublishDir 顺着 MSBuild 任务流进插件工程。 -->
    <ItemGroup>
      <_VelaLocalPluginProject Include="$(MSBuildThisFileDirectory)..\..\plugins\*\*.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(_VelaLocalPluginProject)" Targets="GetVelaPluginPayload" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishAot;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="_VelaLocalPluginPayload" />
    </MSBuild>

    <!-- ② 本机自己铺在暂存目录里的插件仓库侧插件。CI 上不存在这个目录,
         这一项为空是**正常**的。.bundle-version 是早年取件脚本留下的印记,存量机器上可能还有,不进包。 -->
    <ItemGroup>
      <_VelaStagedPluginPayload Include="$(VelaPluginsStageDir)\**\*" Exclude="$(VelaPluginsStageDir)\.bundle-version" />
    </ItemGroup>

    <!-- 一个插件都没有会悄无声息地发出"插件系统看着在、实则没插件"的包,宁可在这里断掉发布。
         正常路径靠①兜底:②不进发行包之后,这条只会在本仓库的插件也全军覆没时才响。 -->
    <Error Condition="'@(_VelaLocalPluginPayload)' == '' and '@(_VelaStagedPluginPayload)' == ''" Text="发布产物里没有任何插件:plugins/ 下没有 &lt;VelaPluginShip&gt;true&lt;/VelaPluginShip&gt; 的插件工程,插件暂存目录 '$(VelaPluginsStageDir)' 也是空的或不存在。发行包里的插件本该来自 plugins/ 下的插件工程 —— 先查那边为什么没产出;确实想把插件仓库侧的插件一并打进去,把它们铺进暂存目录再发布。" />

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_VelaLocalPluginPayload)">
        <RelativePath>plugins\%(_VelaLocalPluginPayload.VelaPluginRelativePath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_VelaStagedPluginPayload)">
        <RelativePath>plugins\%(_VelaStagedPluginPayload.RecursiveDir)%(_VelaStagedPluginPayload.Filename)%(_VelaStagedPluginPayload.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    看门狗:确保应用自身的 copy-local 产物一个都没在发布期被消重掉(#181)。

    ComputeResolvedFilesToPublishList 正文里的 ResolveOverlappingItemGroupConflicts 按文件名
    在"应用产物"与"此刻已登记的 ResolvedFileToPublish"之间挑输赢,凡是在它跑之前往
    ResolvedFileToPublish 里塞过东西的自定义 target(本项目的 AddVelaPluginsToPublish 就是,
    见上),都可能让应用根目录悄悄少掉一个 dll —— 构建全绿、包也照出,只在最终用户
    双击时炸(1.2.2 的 MicroCom.Runtime 即如此,启动直接 FileNotFoundException)。
    这里前后各取一次快照,差集非空就断掉发布,把"顺序约束"从注释变成硬约束。

    Before 的 target 在 DependsOnTargets(_ComputeResolvedCopyLocalPublishAssets)之后、
    正文之前执行,因此拿到的正是消重前的完整集合。
  -->
  <Target Name="_SnapshotVelaAppPublishAssets" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_VelaAppPublishAssetBefore Include="@(_ResolvedCopyLocalPublishAssets)" />
    </ItemGroup>
  </Target>

  <Target Name="VerifyVelaAppPublishAssetsIntact" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_VelaAppPublishAssetDropped Include="@(_VelaAppPublishAssetBefore)" Exclude="@(_ResolvedCopyLocalPublishAssets)" />
    </ItemGroup>
    <Error Condition="'@(_VelaAppPublishAssetDropped)' != ''" Text="发布产物缺少应用自身的依赖(被发布期文件名冲突消重删掉了):@(_VelaAppPublishAssetDropped->'%(Filename)%(Extension)', ', ')。多半是又有 target 在 ComputeResolvedFilesToPublishList **之前**往 ResolvedFileToPublish 里登记了同名文件(见 AddVelaPluginsToPublish 的注释,#181)。" />
  </Target>
</Project>
