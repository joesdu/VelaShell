<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia UI。plugins/ 下的插件只在编译期引用 Avalonia / Avalonia.AvaloniaEdit
         (运行时回落到宿主这份),那两个版本号必须与这里逐字一致 —— 改这里就得同步改
         plugins/VelaShell.Plugin.Ai/VelaShell.Plugin.Ai.csproj。 -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!--<PackageVersion Include="Avalonia.Wayland" Version="12.1.2" />-->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.2" />
    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <!-- 其它 -->
    <PackageVersion Include="ReactiveUI" Version="24.2.0" />
    <!-- MMDB 读取器(Apache 2.0)。只是格式读取库,不绑定 MaxMind 的数据 ——
         我们配的是 DB-IP Lite City(CC BY 4.0),同一格式。 -->
    <PackageVersion Include="MaxMind.Db" Version="5.2.0" />
    <PackageVersion Include="SonnetDB.Core" Version="3.1.0" />
    <!-- BouncyCastle(MIT 改写版许可,与商业授权不冲突)。两个使用者共用这一条版本:
           · VelaShell.Ssh —— BCL 缺失的密码学原语(raw ChaCha20、Poly1305、Ed25519、X25519、
             sntrup761、Argon2id…),是那个库唯一的运行时依赖;
           · VelaShell.Infrastructure —— Ed25519 密钥生成(SshKeyService):.NET 11 的 BCL
             仍然没有独立的 Ed25519(只有 CompositeMLDsa 里那个复合算法标识符)。
         SSH 库 2026-09-23 并入本仓库之后两边读的是同一条 PackageVersion,不会再漂。 -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- FTP / FTPS 客户端(MIT,零依赖)。截至 54.2.0 最高只出到 net9.0 资产,
         本仓库 net11.0 会解析到那一份 —— 纯托管 DLL,且发布不裁剪、非单文件,无打包风险。
         注意:不要顺手引 FluentFTP.GnuTLS(LGPL-2.1-only),与商业授权冲突,
         详见 velashell-docs 仓库 zh/host/FTP客户端可行性调研.md §4.3。 -->
    <PackageVersion Include="FluentFTP" Version="55.0.0" />
    <!-- 插件契约程序集,由 VelaShellLabs/velashell-plugin-sdk 发布到 nuget.org。
         注意:S3 插件用的 AWSSDK.S3 曾经登记在这里 —— 那个插件在第一方插件仓库
         (VelaShellLabs/velashell-plugins)里,版本由那边的中央包管理登记,别再加回来。
         本仓库 plugins/ 下的插件(AI)不走中央包版本管理
         (根目录没有 Directory.Packages.props),依赖版本写在各自的 csproj 里。 -->
    <PackageVersion Include="VelaShell.PluginSdk" Version="2.0.4" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-rc.1.26425.128" />
    <!-- 构建期工具:SourceLink(见 src/Directory.Build.props) -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.1.26425.128" />
  </ItemGroup>
</Project>