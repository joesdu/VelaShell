<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VelaShell.XServer —— 可嵌入的 X11 服务端(rootless,软件绘图,无原生依赖)。

    与 VelaShell.Ssh 同样的定位:一个独立的 MIT 库,放在宿主仓库里、不单独发包,
    宿主经 Host/IXServerHost 接进来。按文件夹分层:

      Protocol/     常量、字节序感知的读写、BIG-REQUESTS
      Transport/    监听、连接建立、授权
      Server/       执行循环、客户端表、请求分派(按领域拆成 partial 文件)
      Resources/    原子、属性、颜色表、光标、GC、像素图
      Windowing/    窗口树、可见区域、Expose、事件投递
      Drawing/      软件帧缓冲与光栅化
      Fonts/        BDF、内置 misc-fixed 字体、XLFD 匹配
      Input/        键码表、焦点、抓取
      Extensions/   扩展注册表
      Host/         面向宿主的接口

    架构、净室规程与里程碑见 velashell-docs/zh/xserver/design/architecture.md;
    开发纪律见同目录 AGENTS.md。本目录按 MIT 授权(LICENSE / NOTICE.md)。
  -->

  <PropertyGroup>
    <Description>Embeddable, rootless X11 server for .NET — core protocol, software rendering, no native dependencies. Independent implementation; see NOTICE.md.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内置位图字体(X.Org font-misc-misc,公有领域),见 Fonts/Data/README.md。 -->
    <EmbeddedResource Include="Fonts/Data/*.bdf" LogicalName="VelaShell.XServer.Fonts.%(Filename).bdf" />
  </ItemGroup>

  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="VelaShell.XServer.Tests" />
  </ItemGroup>

</Project>
