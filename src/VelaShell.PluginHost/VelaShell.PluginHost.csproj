<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 这是发行包里第二个可执行体,隔离插件一开就出现在任务管理器和杀软日志里;
         FileDescription 空着或只是程序集名,用户看不出它跟 VelaShell 的关系。 -->
    <AssemblyTitle>VelaShell Plugin Host</AssemblyTitle>
    <Description>VelaShell 隔离插件宿主进程:经命名管道 RPC 连接主程序,在可收集 ALC 中装载并运行单个插件。</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 只依赖 SDK 契约,严禁引用任何 VelaShell.* 主程序工程(设计稿 02 §2 依赖纪律)。 -->
  </PropertyGroup>

  <!-- 与主程序同口径(VelaShell.csproj 的 Release 段):主程序 Release 自包含,它引用的这个可执行体也得自包含,
       否则不带 -p:SelfContained=true 的本机 Release 构建报 NETSDK1150。发布流水线命令行上本来就传它(全局属性,两边都吃到),
       这里只是让本机的 Release 构建也对得上。别改成关掉 ValidateExecutableReferencesMatchSelfContained:那道检查拦的
       正是「主程序自包含、PluginHost 却要找系统里的 .NET 运行时」—— 那样的包装到用户机器上,隔离插件一个也起不来。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the main host before .NET caches Unix authentication provider selection. -->
    <RuntimeHostConfigurationOption Include="System.Net.Security.UseManagedNtlm" Value="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="VelaShell.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件契约程序集。取 nuget.org 上的正式包,版本 = 根 Directory.Build.props 的
         VelaSdkVersion(由 joesdu/velashell-plugin-toolchain 发布)。 -->
    <PackageReference Include="VelaShell.PluginSdk" />
  </ItemGroup>

  <ItemGroup>
    <!-- 隔离插件的完整 UI:本进程内建 Avalonia(与宿主同版,由 CPM 钉住)。
         插件程序集的 Avalonia 引用经 ALC 回落到本进程这套,保证类型同一。 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
