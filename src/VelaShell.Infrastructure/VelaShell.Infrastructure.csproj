<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VelaShell.Core\VelaShell.Core.csproj" />
    <!--
      VelaShell.Ssh 是宿主的 SSH 库(替换了 Tmds.Ssh)。它原本在独立仓库
      VelaShellLabs/velashell-ssh,2026-09-23 并入本仓库 src/VelaShell.Ssh,不再单独发 NuGet ——
      它只有宿主一个使用者,为它维护一条发版流水线得不偿失;同仓以后改库、改宿主一个 PR 就够。
      作为本仓工程它随 Release 一起强名签名,不存在引未签名程序集的 CS8002 问题。
    -->
    <ProjectReference Include="..\VelaShell.Ssh\VelaShell.Ssh.csproj" />
    <!-- 插件契约程序集。取 nuget.org 上的正式包,版本 = 根 Directory.Build.props 的
         VelaSdkVersion(由 joesdu/velashell-plugin-toolchain 发布)。 -->
    <PackageReference Include="VelaShell.PluginSdk" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="MaxMind.Db" />
    <PackageReference Include="SonnetDB.Core" />
    <!-- 仅用于 Ed25519 密钥生成(SshKeyService):BCL 至今没有 Ed25519。见中央包版本处的注释。 -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <!-- DPAPI(CurrentUser)包裹本地 AES 密钥文件;仅 Windows 运行时可用,其余平台已代码守卫。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <!-- 见 VelaShell.Terminal.csproj 同处注释:签名构建(Release)省略友元声明,非签名构建保留。
       本项目的友元是 VelaShell.Core.Tests(SSH 包装类与异常翻译的白盒测试放在那边)。 -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="VelaShell.Core.Tests" />
    <InternalsVisibleTo Include="VelaShell.Infrastructure.Tests" />
  </ItemGroup>

</Project>
