<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VelaShell.Plugin.Ai.Ui.TeamConsoleStyles">

  <!-- 团队控制台是独立文档,不在聊天面板的资源作用域下:图标、LiveMarkdown 的默认令牌与样式、
       Markdown 皮肤都在这里并入,页面只需要 Styles.Add(new TeamConsoleStyles())。
       【必须写在编译的 XAML 里,不能在代码里按 avares:// 地址运行期并入。】宿主自己也引 LiveMarkdown.Avalonia,
       而插件在自己的装载上下文里另有一份:运行期按程序集名找,可能找到宿主那份,样式选中的就是另一套类型,
       报告会渲染成没有模板的空白。写在这里由 XAML 编译器静态绑到插件引用的那一份(与 ChatPanelView.axaml 同一条路)。 -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelaShell.Plugin.Ai/Ui/AiTheme.axaml" />
        <!-- 字号等默认令牌必须在;颜色键随后由 MarkdownSkin.Sync 写进页面自己的资源(直接键优先) -->
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 顺序不能换:LiveMarkdown 自带样式在前,皮肤在后才压得住 -->
  <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
  <StyleInclude Source="avares://LiveMarkdown.Avalonia.Mermaid/Styles.axaml" />
  <StyleInclude Source="avares://VelaShell.Plugin.Ai/Ui/MarkdownSkin.axaml" />

  <!-- 团队控制台(TeamConsoleView)的版式。层次自下而上四档底色:
       页面 VelaBgPage → 面板 VelaBgSidebar → 卡片 VelaBgInput → 凹槽 / 悬停 VelaBgHover,
       这四个令牌在深浅两套主题里都保持「一层比一层更靠前」的次序。配色全部走 Vela* 令牌。 -->

  <!-- 面板:圆角大卡,所有分区都装在它里面 -->
  <Style Selector="Border.tcPanel">
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- 顶部的六块统计 -->
  <Style Selector="Border.tcStat">
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="6" />
  </Style>

  <!-- 成员卡 / 抽屉里的条目:整块可点,悬停换描边 -->
  <Style Selector="Border.tcCard">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tcCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.tcItem">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tcItem:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>

  <!-- 抽屉里的小数据格 -->
  <Style Selector="Border.tcCell">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <!-- 任务行 / 用量行 / 通信记录行:平时无底,悬停提亮 -->
  <Style Selector="Border.tcRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tcRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
  </Style>
  <Style Selector="Border.tcFeedRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tcFeedRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
  </Style>

  <!-- 凹槽:进度条、用量条、时间轴的底 -->
  <Style Selector="Border.tcTrough">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- 成员筛选药丸 -->
  <Style Selector="Border.tcFilter">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="99" />
    <Setter Property="Padding" Value="4,3,9,3" />
    <Setter Property="Margin" Value="0,0,8,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tcFilter:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
  </Style>
  <Style Selector="Border.tcFilter.on">
    <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>

  <!-- 抽屉头部的方形图标钮 -->
  <Style Selector="Button.tcIconButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tcIconButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
  </Style>

  <!-- 通信记录上方的类型下拉与搜索框:与页面里其它描边件同一档圆角 -->
  <Style Selector="ComboBox.tcSelect">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="110" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tcSearch">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Width" Value="190" />
    <Setter Property="Padding" Value="9,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tcSearch:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
  </Style>
  <Style Selector="Border.tcSearch:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
  </Style>
  <Style Selector="Border.tcSearch TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,0,8,0" />
    <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tcSearch TextBox /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- 抽屉:贴右的一整列,盖在页面上 -->
  <Style Selector="Border.tcDrawer">
    <Setter Property="Background" Value="{DynamicResource VelaBgSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BoxShadow" Value="{DynamicResource VelaShadowWindow}" />
  </Style>

  <!-- 对话气泡:自己说的在左,对方说的在右(略带对方身份色,由代码叠一层淡色底) -->
  <Style Selector="Border.tcBubble">
    <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tcBubble.focus">
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- 选中消息的元数据框 -->
  <Style Selector="Border.tcMeta">
    <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <!-- 工具调用折叠块 / 等宽输出 -->
  <Style Selector="Border.tcCode">
    <Setter Property="Background" Value="{DynamicResource VelaBgPage}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

</Styles>
