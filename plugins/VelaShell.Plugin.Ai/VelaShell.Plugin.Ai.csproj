<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>VelaShell AI 助手插件:多提供商(OpenAI/Anthropic/Grok/Ollama/中转站)流式对话、Agent 模式与自定义 MCP 服务器工具。</Description>
    <!-- 与 plugin.json 的 id 一致;驱动构建后复制到应用输出的 plugins/<目录名>/
         (目录名 = id 把点换成短横,原因见 plugins/Directory.Build.targets)。 -->
    <VelaPluginId>velashell.ai</VelaPluginId>
    <!-- AVLN3001:面板视图刻意只有带上下文的构造(由 ShowPanelAsync 工厂创建),
         不需要运行时 XAML 装载器的无参构造路径。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 输入框的 Markdown 着色定义。EmbeddedResource 而非 AvaloniaResource:
         HighlightingLoader 要的是普通 Stream(与宿主 Syntax/*.xshd 的处置一致)。 -->
    <EmbeddedResource Include="Ui\MarkdownInput.xshd" />
    <!-- models.dev 规格快照:发版流水线跑 scripts/Update-ModelsDevSnapshot.ps1 生成(不进版本库,见 .gitignore)。
         没有外网 / 被墙的用户第一次拉取模型也有窗口与单价可用;本地开发没有这两个文件时不打包,行为与以前一样。 -->
    <EmbeddedResource Include="Assets\models-dev.json.gz" LogicalName="VelaShell.Plugin.Ai.models-dev.json.gz" Condition="Exists('Assets\models-dev.json.gz')" />
    <EmbeddedResource Include="Assets\models-dev.stamp" LogicalName="VelaShell.Plugin.Ai.models-dev.stamp" Condition="Exists('Assets\models-dev.stamp')" />
    <!-- SseRepairHandler 是纯 HTTP 层的东西,没必要为了测它变成公开 API。 -->
    <InternalsVisibleTo Include="VelaShell.Plugin.Ai.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK 由宿主统一提供(共享契约程序集),不随插件输出复制。
         plugin-sdk 的源码在工具链仓库(joesdu/velashell-plugin-toolchain),这里取正式包。
         PrivateAssets=all + ExcludeAssets=runtime:编译期能看见类型,输出目录里不留 dll ——
         装载时它必须与宿主是同一份程序集,复制过去就成了两份类型。
         版本须与 src/Directory.Packages.props 里宿主引的那一条一致。 -->
    <PackageReference Include="VelaShell.PluginSdk" Version="2.2.0" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 仅编译期引用 Avalonia,运行时由装载方共享同一套(版本须与宿主一致)。 -->
    <PackageReference Include="Avalonia" Version="12.1.6" ExcludeAssets="runtime" />
    <!-- 输入框是 AvaloniaEdit(Markdown 高亮 + @ 引用芯片,纯 TextBox 给不了内联富文本)。
         程序集名 AvaloniaEdit 命中 PluginAssemblyLoadContext 的 SharedPrefixes("Avalonia"),
         运行时一律回落到装载方那份,故此处同样只要编译期引用。
         注意:因此本插件必须进程内装载(plugin.json 未声明 isolated)—— 隔离宿主进程里
         没有 AvaloniaEdit,回落会找不到程序集。 -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" ExcludeAssets="runtime" />
    <!-- AI 栈(用户决策 2026-08-10):Microsoft.Extensions.AI 抽象 + 各家官方 SDK,
         统一到 IChatClient;Agent 循环用 FunctionInvokingChatClient。
         这些依赖随插件目录分发,由插件 ALC 按 deps.json 隔离解析,与宿主互不干扰。 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <!-- MCP 官方 C# SDK(Core = 纯客户端/低层,无 Hosting/DI 依赖):
         McpClientTool 即 M.E.AI 的 AIFunction,直接并入 Agent 工具循环。 -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
    <!-- Markdown 渲染:LiveMarkdown.Avalonia(内部仍是 Markdig 解析,增量做在渲染层 ——
         按 SourceSpan 脏检查只更新受影响节点,解析放后台线程)。自带 TextMate 代码高亮、
         跨块选择、表格/任务列表。程序集名不以 "Avalonia" 开头,因此走插件 ALC 隔离加载
         (PluginAssemblyLoadContext 只把 Avalonia* 前缀回落到默认 ALC),不污染宿主。
         三个可选节点扩展见下,注册在 Ui/MarkdownExtensions.cs。 -->
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.7.0" />
    <!-- Mermaid:```mermaid 代码块画成原生 Avalonia 图(Mermaider 纯托管解析+布局,
         无浏览器无子进程),自带平移缩放。 -->
    <PackageReference Include="LiveMarkdown.Avalonia.Mermaid" Version="2.7.0" />
    <!-- LaTeX:$..$ / $$..$$,并补 \(..\) / \[..\](多数模型实际输出的定界符)。
         2.5.0 使用 RaTeX 后端,公式前景色由 Markdown 控件继承。 -->
    <PackageReference Include="LiveMarkdown.Avalonia.Math" Version="2.7.0" />
    <!-- SVG:给图片管线注册 SVG 解码器。用 Svg.Controls.Avalonia 后端(非 Skia,用户决策)。 -->
    <PackageReference Include="LiveMarkdown.Avalonia.Svg" Version="2.7.0" />
  </ItemGroup>

  <!--
    与宿主共用的传递依赖:宿主根目录已经带着同版本的同一份程序集(宿主自己也引
    LiveMarkdown.Avalonia),插件目录里再放一份只是白占包体,装载后还在内存里多一份。
    VelaHostSharedPackage 由 plugins/Directory.Build.targets 展开成
    ExcludeAssets="runtime;native" 的 PackageReference:编译照常,输出目录与 deps.json 里都没有它们,
    插件 ALC 的依赖解析器找不到就回落默认 ALC,用宿主那份(原生库 libonigwrap 同理)。

    只放**纯函数库**:不在静态里攒调用方对象,插件 ALC 卸载不受影响。LiveMarkdown.Avalonia 本身
    刻意留在插件 ALC 里(三个节点扩展注册在它的渲染管线上,共享后宿主会攥住插件类型、ALC 卸不掉);
    System.Numerics.Tensors 两边版本不同(宿主经 SonnetDB 是 10.x),也不共享。
    版本必须与宿主发行包里的完全一致,发布期由 VelaShell.csproj 的 VerifyVelaHostSharedPackages 核对。
  -->
  <ItemGroup>
    <VelaHostSharedPackage Include="Markdig" Version="1.1.2" />
    <VelaHostSharedPackage Include="TextMateSharp" Version="2.0.0" />
    <VelaHostSharedPackage Include="TextMateSharp.Grammars" Version="2.0.0" />
    <VelaHostSharedPackage Include="Onigwrap" Version="1.0.9" />
    <VelaHostSharedPackage Include="MicroCom.Runtime" Version="0.11.6" />
    <!-- Avalonia 的传递依赖;名字命中 SharedPrefixes("Avalonia"),插件目录里那份本来就从不装载。 -->
    <VelaHostSharedPackage Include="Avalonia.Remote.Protocol" Version="12.1.6" />
    <!-- 二维码(协作接入页上「把机器人拉进群」的链接)自己编,见 Ui/QrCode.cs。
         这里曾经引 QRCoder 1.8.0,当时判断是"MIT,netstandard2.0,无传递依赖" ——
         这条判断是错的:它的 netstandard2.0 目标依赖 System.Drawing.Common 6.0.0
         (再带 Microsoft.Win32.SystemEvents)。那个库 6.0 之后官方只支持 Windows,
         并且带来的 runtimes/{win,unix}/lib/net6.0/ 目录名里有点号,会被 macOS 的
         codesign 当成嵌套 bundle 而把 dmg 打包整个炸掉(1.4.8 踩过,与 plugins/README.md
         记的插件目录名那次是同一个坑)。**再加包之前先看清它的传递依赖。** -->
  </ItemGroup>

</Project>
