{
  "id": "velashell.ai",
  "version": "1.9.1",
  "displayName": "VelaShell Copilot",
  "description": "多提供商 AI 助手:通过 API Key 接入自定义 OpenAI / Anthropic 兼容端点;不提供账号登录或订阅授权,以保护账号安全、降低封号风险、减少维护成本并简化界面;支持流式对话、Agent 模式与自定义 MCP 服务器工具;会话存入时序库可随时翻回,输入框 ↑↓ 调历史、@ 引用服务器文件。",
  "publisher": "velashell",
  "entry": "VelaShell.Plugin.Ai.dll",
  "apiLevel": 2,
  "minHostVersion": "1.9.1",
  "minSdkVersion": "2.2.1",
  "license": "MIT",
  "homepage": "https://github.com/joesdu/VelaShell",
  // 启动即激活。IM 桥接必须常驻 —— 飞书/钉钉那头的消息随时会来,不能等用户
  // 点开 AI 面板才建连。代价是本插件不再惰性装载;换来的是 ActivateAsync 里只多
  // 一次配置读取(桥接关着时立刻返回),而聊天面板依旧是首次触发命令才构造。
  "activationEvents": [
    "onStartup",
    "onCommand:velashell.ai.chat",
    "onCommand:velashell.ai.chat-window",
    "onCommand:velashell.ai.explain-terminal"
  ],
  "contributes": {
    "commands": [
      { "id": "velashell.ai.chat", "title": "VelaShell Copilot: Open Assistant", "category": "VelaShell Copilot" },
      { "id": "velashell.ai.chat-window", "title": "VelaShell Copilot: Open Chat (Window)", "category": "VelaShell Copilot" },
      { "id": "velashell.ai.explain-terminal", "title": "VelaShell Copilot: Explain Terminal Output", "category": "VelaShell Copilot" },
      { "id": "velashell.ai.collaboration", "title": "VelaShell Copilot: Collaboration (chat bridge & MCP server)", "category": "VelaShell Copilot" }
    ]
  }
}
