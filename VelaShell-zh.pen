                          "name": "tmShellSnippet0Val",
                          "fill": "$text-primary",
                          "content": "PS1=\"\\[\\e]133;A\\a\\]$PS1\\[\\e]133;B\\a\\]\"",
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 10,
                          "fontWeight": "normal"
                        }
                      ]
                    },
